<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MazGuard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_bright</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/brand_bright</item>
        <item name="colorSecondaryVariant">@color/brand</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.MazGuard.Gate" parent="Theme.MazGuard">
        <item name="android:windowBackground">@color/gate_bg</item>
        <item name="android:statusBarColor">@color/gate_bg</item>
        <item name="android:navigationBarColor">@color/gate_bg</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.MazGuard.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
