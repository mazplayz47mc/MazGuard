<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Hisn" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialButtonStyle">@style/Widget.Hisn.Button</item>
        <item name="textInputStyle">@style/Widget.Hisn.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.Hisn.Chip</item>
    </style>

    <style name="Theme.Hisn.Gate" parent="Theme.Hisn">
        <item name="android:windowBackground">@color/gate_bg</item>
        <item name="android:statusBarColor">@color/gate_bg</item>
        <item name="android:navigationBarColor">@color/gate_bg</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.Hisn.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="rippleColor">@color/brand_dim</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <style name="Widget.Hisn.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="rippleColor">@color/brand_dim</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Hisn.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="rippleColor">@color/brand_dim</item>
    </style>

    <style name="Widget.Hisn.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/ink_subtle</item>
        <item name="android:textColorHint">@color/ink_subtle</item>
    </style>

    <style name="Widget.Hisn.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/surface_raised</item>
        <item name="checkedIconTint">@color/brand</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">@color/brand_dim</item>
    </style>

</resources>